{
  "name": "gmc-wishing-tree",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "migrate": "tsx server/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "demo": "cross-env DEMO_MODE=true VITE_DEMO=true npm run dev"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.180.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
