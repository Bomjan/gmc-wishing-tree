DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishing_tree_db
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
# base64-encoded 32-byte keys; generate independently using openssl rand -base64 32
ENCRYPTION_KEY=
TOKEN_SECRET=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
UNDO_SECONDS=10
USERNAME_MIN=3
USERNAME_MAX=24
WISH_MAX=500
DEMO_MODE=false
VITE_DEMO=false
VITE_IDLE_SECONDS=60
VITE_HIGHLIGHT_SECONDS=12

# Optional image-capable model override for signature moderation.
SIGNATURE_AI_MODEL=

# Default vertical centre of visitor controls (fraction from the top); adjustable on screen.
VITE_CONTROL_HEIGHT=0.32
